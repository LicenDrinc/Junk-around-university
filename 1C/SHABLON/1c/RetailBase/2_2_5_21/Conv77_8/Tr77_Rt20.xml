		ЗначенияПолей.Установить("ТипКвартиры", "кв.");
		
		// Получение полей адреса
		АдресСписком = глРазложить(Адрес);
		Попытка
			ЗначенияПолей.Установить("Индекс",			АдресСписком.ПолучитьЗначение(2));
			ЗначенияПолей.Установить("Регион",			АдресСписком.ПолучитьЗначение(3));
			ЗначенияПолей.Установить("Район",			АдресСписком.ПолучитьЗначение(4));
			ЗначенияПолей.Установить("Город",			АдресСписком.ПолучитьЗначение(5));
			ЗначенияПолей.Установить("НаселенныйПункт",	АдресСписком.ПолучитьЗначение(6));
			ЗначенияПолей.Установить("Улица", 			АдресСписком.ПолучитьЗначение(7));
			ЗначенияПолей.Установить("Дом",				АдресСписком.ПолучитьЗначение(8));
			ЗначенияПолей.Установить("Корпус",			АдресСписком.ПолучитьЗначение(9));
			ЗначенияПолей.Установить("Квартира",			АдресСписком.ПолучитьЗначение(10));
		Исключение
		КонецПопытки;
		
		КоллекцияОбъектов.Город  = ЗначенияПолей.Получить("Город");
		КоллекцияОбъектов.Регион = ЗначенияПолей.Получить("Регион");
		КоллекцияОбъектов.Страна = ЗначенияПолей.Получить("Страна");
		
		КоллекцияОбъектов.ЗначенияПолей = "";
		Для Номер = 1 По ЗначенияПолей.РазмерСписка() Цикл
			Ключ = "";
			Значение = ЗначенияПолей.ПолучитьЗначение(Номер, Ключ);
			КоллекцияОбъектов.ЗначенияПолей = КоллекцияОбъектов.ЗначенияПолей + ?(ПустоеЗначение(Значение) = 0, Ключ + "=" + Значение + Симв(10), "");
		КонецЦикла;
		КоллекцияОбъектов.ЗначенияПолей = Лев(КоллекцияОбъектов.ЗначенияПолей, СтрДлина(КоллекцияОбъектов.ЗначенияПолей) - 1);
		
		Представление = "";
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Индекс"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("Индекс")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Регион"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("Регион")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Район"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("Район")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Город"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("Город")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("НаселенныйПункт"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("НаселенныйПункт")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Улица"))) = 0, ", " + СокрЛП(ЗначенияПолей.Получить("Улица")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Дом"))) = 0, ", " + ЗначенияПолей.Получить("ТипДома") + " № " + СокрЛП(ЗначенияПолей.Получить("Дом")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Корпус"))) = 0, ", " + ЗначенияПолей.Получить("ТипКорпуса") + " " + СокрЛП(ЗначенияПолей.Получить("Корпус")), "");
		Представление = Представление + ?(ПустоеЗначение(СокрЛП(ЗначенияПолей.Получить("Квартира"))) = 0, ", " + ЗначенияПолей.Получить("ТипКвартиры") + " " + СокрЛП(ЗначенияПолей.Получить("Квартира")), "");
		
		Если СтрДлина(Представление) &gt; 2 Тогда
			Представление = Сред(Представление, 3);
		КонецЕсли;
		
		КоллекцияОбъектов.Представление = Представление;
		
	Иначе
		КоллекцияОбъектов.Представление = Адрес;
	КонецЕсли;
</Текст>
