	// Вырежем слева www
	Если НРег(Лев(Стр, 4)) = "www." Тогда
		Стр = Сред(Стр, 5);
	КонецЕсли;
	
	Поз = Найти(Стр, "/");
	КоллекцияОбъектов.ДоменноеИмяСервера = ?(Поз = 0, Стр, Лев(Стр, Поз-1));


</Текст>
