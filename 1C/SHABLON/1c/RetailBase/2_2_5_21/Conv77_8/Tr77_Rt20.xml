		<Алгоритм Имя="СформироватьСписокНоменклатурыСУпаковками" ИспользуетсяПриЗагрузке="false">
			<Текст>Параметры.НоменклатураСУпаковками = СоздатьОбъект("СписокЗначений");

Запрос = СоздатьОбъект("Запрос");
ТекстЗапроса =
"//{{ЗАПРОС(СписокЕдиницИзмерения)
|Без итогов;
|ТекущийЭлемент = Справочник.Единицы.ТекущийЭлемент;
|Владелец = Справочник.Единицы.Владелец;
|Вес = Справочник.Единицы.Вес;
|Коэффициент = Справочник.Единицы.Коэффициент;
|ОКЕИ = Справочник.Единицы.ОКЕИ;
|Группировка Владелец упорядочить по Владелец.Код;
|Группировка ТекущийЭлемент;
|"//}}ЗАПРОС
;

Запрос.Выполнить(ТекстЗапроса);

ТабЕдиницИзмерения = СоздатьОбъект("ТаблицаЗначений");
Запрос.Выгрузить(ТабЕдиницИзмерения, 1, 0);

ТекстЗапроса =
"//{{ЗАПРОС(СписокНоменклатуры)
|ТекущийЭлемент = Справочник.Номенклатура.ТекущийЭлемент;
|БазоваяЕдиница = Справочник.Номенклатура.БазоваяЕдиница;
|ОКЕИ = Справочник.Номенклатура.БазоваяЕдиница.ОКЕИ;
|Группировка ТекущийЭлемент без групп упорядочить по ТекущийЭлемент.Код;
|"//}}ЗАПРОС
;
	
// Сопоставление данных о номенклатуре и единицах измерения
Запрос.Выполнить(ТекстЗапроса);
Пока Запрос.Группировка() = 1 Цикл
	
	НомерНачальнойСтроки = 0;
	Если ТабЕдиницИзмерения.НайтиЗначение(Запрос.ТекущийЭлемент, НомерНачальнойСтроки, "Владелец") = 1 Тогда
		Для НомерСтроки = НомерНачальнойСтроки По ТабЕдиницИзмерения.КоличествоСтрок() Цикл
			
			ТабЕдиницИзмерения.ПолучитьСтрокуПоНомеру(НомерСтроки);
			Если ТабЕдиницИзмерения.Владелец &lt;&gt; Запрос.ТекущийЭлемент Тогда
				Прервать;
			КонецЕсли;
			
			Если НЕ (((ТабЕдиницИзмерения.Коэффициент = 1) ИЛИ (ТабЕдиницИзмерения.ТекущийЭлемент = Запрос.БазоваяЕдиница)) 
				И (ТабЕдиницИзмерения.ОКЕИ = Запрос.ОКЕИ) И (ТабЕдиницИзмерения.Вес = 0)) Тогда
				Параметры.НоменклатураСУпаковками.ДобавитьЗначение(Запрос.ТекущийЭлемент);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецЦикла;</Текст>
		</Алгоритм>
		<Алгоритм Имя="СформироватьТаблицуКонтрагентовСЮрЛицами" ИспользуетсяПриЗагрузке="false">
			<Текст>Запрос = СоздатьОбъект("Запрос");
ТекстЗапроса =
"//{{ЗАПРОС(Контрагенты_ЮрФизЛицо)
|Без итогов;
|Контрагент = Справочник.Контрагенты.ТекущийЭлемент;
|ЮрФизЛицо = Справочник.Контрагенты.ЮрФизЛицо;
|Группировка Контрагент без групп;
|"//}}ЗАПРОС
;

Параметры.ЮрФизЛицаСКонтрагентами = СоздатьОбъект("ТаблицаЗначений");
Запрос.Выполнить(ТекстЗапроса);

Запрос.Выгрузить(Параметры.ЮрФизЛицаСКонтрагентами, 1, 0);

</Текст>
		</Алгоритм>
		<Алгоритм Имя="УстновитьПараметрИспользоватьУпаковки" ИспользуетсяПриЗагрузке="false">
			<Текст>ИспользоватьУпаковки = 0;

СпрЕдиницы = СоздатьОбъект("Справочник.Единицы");
СпрЕдиницы.ВыбратьЭлементы(0);
Пока СпрЕдиницы.ПолучитьЭлемент() = 1 Цикл
	
	ЭтоУпаковка = 1;
	Если (СпрЕдиницы.Вес = 0)
		И (ПустоеЗначение(СпрЕдиницы.ШтрихКод) = 1)
		И ((СпрЕдиницы.Коэффициент = 1) ИЛИ (СпрЕдиницы.ТекущийЭлемент() = СпрЕдиницы.Владелец.БазоваяЕдиница))
		И (СпрЕдиницы.ОКЕИ = СпрЕдиницы.Владелец.БазоваяЕдиница.ОКЕИ) Тогда
		ЭтоУпаковка = 0;
	КонецЕсли;
	
	Если ЭтоУпаковка = 1 Тогда
	    ИспользоватьУпаковки = 1;
		Прервать;
